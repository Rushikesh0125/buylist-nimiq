{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buylist-nimiq-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_ORIGIN": "http://localhost:8787",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "BRYNTUM_LICENSE_CONFIRMED": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buylist-nimiq-staging",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "buylist-nimiq-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://buylist-nimiq-staging.jadhav-rushikesh-ggl.workers.dev",
        "NIMIQ_TESTNET_USD_RATE": "0.00025563",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "BRYNTUM_LICENSE_CONFIRMED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "buylist-nimiq-staging",
          "database_id": "3a856e5b-a7d0-42a2-9cb1-06f7248dee75",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    },
    "production": {
      "name": "buylist-nimiq-production",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://buylist-nimiq-production.example.invalid",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "BRYNTUM_LICENSE_CONFIRMED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "buylist-nimiq-production",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  }
}
