{
  "name": "buylist-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --local --port 8787",
    "types": "wrangler types worker/bindings.d.ts --env-interface CloudflareBindings",
    "db:local": "wrangler d1 migrations apply buylist-nimiq-staging --local",
    "db:staging": "wrangler d1 migrations apply buylist-nimiq-staging --env staging --remote",
    "db:production": "wrangler d1 migrations apply buylist-nimiq-production --env production --remote",
    "test": "wrangler deploy --dry-run --env staging --outdir .wrangler/build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "deploy:staging": "npm run typecheck && npm run build && wrangler deploy --env staging",
    "deploy:production": "node scripts/release-check.mjs && npm run typecheck && npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@bryntum/scheduler-react": "^7.3.8",
    "@bryntum/scheduler-trial": "^7.3.8",
    "@channel3/sdk": "^4.6.0",
    "@fontsource/bricolage-grotesque": "^5.0.0",
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@nimiq/mini-app-sdk": "^0.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "jose": "^6.2.14",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.156.0"
  }
}
